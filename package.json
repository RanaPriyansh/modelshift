{
  "name": "forge-learning-os",
  "version": "0.1.0",
  "private": true,
  "description": "FORGE is a private Semester Desk for university students to rebuild a difficult week from today.",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/ops/verify-semester-desk-v2-release-artifact.ts && tsx scripts/ops/verify-semester-desk-v2-release-budgets.ts && tsx scripts/ops/verify-public-build-boundary.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config evals/vitest.config.ts",
    "test:watch": "vitest",
    "eval": "tsx evals/run-evals.ts",
    "eval:live": "tsx evals/run-live-evals.ts",
    "eval:lesson-studio:live": "tsx evals/run-lesson-studio-live-evals.ts",
    "test:eval-runner": "vitest run --config evals/vitest.config.ts",
    "test:e2e": "playwright test tests/e2e/semester-desk-v2-canonical.spec.ts",
    "test:e2e:prod": "FORGE_EXPECTED_RELEASE_SHA=${FORGE_EXPECTED_RELEASE_SHA:?Set FORGE_EXPECTED_RELEASE_SHA} tsx scripts/ops/run-production-browser-verification.ts --expected-sha \"$FORGE_EXPECTED_RELEASE_SHA\""
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "next": "16.2.11",
    "openai": "6.48.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
