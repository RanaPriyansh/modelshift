{
  "name": "forge-learning-os",
  "version": "0.1.0",
  "private": true,
  "description": "FORGE — a learner-owned system of reviewed learning Worlds, bounded AI support, and proof after help.",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/ops/verify-public-build-boundary.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config evals/vitest.config.ts",
    "test:watch": "vitest",
    "eval": "tsx evals/run-evals.ts",
    "eval:live": "tsx evals/run-live-evals.ts",
    "eval:lesson-studio:live": "tsx evals/run-lesson-studio-live-evals.ts",
    "test:eval-runner": "vitest run --config evals/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:research-readiness": "FORGE_UNIVERSITY_RESEARCH_READINESS_FIXTURE=forge-university-research-readiness.v1 playwright test tests/e2e/university-research-readiness.spec.ts",
    "test:e2e:university-recovery": "FORGE_UNIVERSITY_RECOVERY_FIXTURE=forge-university-recovery.v1 playwright test tests/e2e/university-recovery.spec.ts",
    "test:e2e:university-recovery-what-if": "FORGE_UNIVERSITY_RECOVERY_FIXTURE=forge-university-recovery-what-if.v1 playwright test tests/e2e/university-recovery-what-if.spec.ts",
    "test:e2e:university-semester-desk": "FORGE_UNIVERSITY_SEMESTER_DESK_FIXTURE=forge-university-semester-desk.v1 playwright test tests/e2e/university-semester-desk.spec.ts",
    "test:e2e:university-semester-overview": "FORGE_UNIVERSITY_SEMESTER_OVERVIEW_FIXTURE=forge-university-semester-overview.v1 playwright test tests/e2e/university-semester-overview.spec.ts",
    "test:e2e:university-post-attempt-repair": "FORGE_UNIVERSITY_POST_ATTEMPT_REPAIR_FIXTURE=forge-university-post-attempt-repair.v1 playwright test tests/e2e/university-post-attempt-repair.spec.ts",
    "test:e2e:university-foundation": "FORGE_UNIVERSITY_COMMAND_CENTER_FIXTURE=forge-university-command-center.v1 FORGE_UNIVERSITY_DEGREE_MAP_FIXTURE=forge-university-degree-map.v1 FORGE_UNIVERSITY_LEARNING_MAP_FIXTURE=forge-university-learning-map.v1 playwright test tests/e2e/university-foundation.spec.ts",
    "test:e2e:prod": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:?Set PLAYWRIGHT_BASE_URL} FORGE_EXPECTED_RELEASE_SHA=${FORGE_EXPECTED_RELEASE_SHA:?Set FORGE_EXPECTED_RELEASE_SHA} playwright test tests/e2e/production.spec.ts tests/e2e/university-research-readiness-production.spec.ts tests/e2e/university-semester-loop-production.spec.ts tests/e2e/university-semester-desk-production.spec.ts tests/e2e/university-semester-overview-production.spec.ts tests/e2e/university-recovery-production.spec.ts tests/e2e/university-post-attempt-repair-production.spec.ts tests/e2e/university-foundation-production.spec.ts tests/e2e/university-source-to-study-production.spec.ts",
    "test:e2e:research-readiness:prod": "tsx scripts/ops/run-production-browser-verification.ts --spec tests/e2e/university-research-readiness-production.spec.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "next": "16.2.11",
    "openai": "6.48.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
