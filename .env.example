# FORGE Semester Desk needs no environment variable for local product use.

# Optional canonical HTTPS origin for metadata, robots, and sitemap output.
# Use an origin without a path. NEXT_PUBLIC_FORGE_SITE_ORIGIN takes priority.
NEXT_PUBLIC_FORGE_SITE_ORIGIN=
FORGE_SITE_ORIGIN=

# Keep indexing off for local and non-approved public environments.
# Vercel production also enables indexing through VERCEL_ENV=production.
FORGE_PUBLIC_INDEXING=false

# The values below are release evidence. CI or an authorized release process
# sets them for one exact candidate. Do not use placeholders as release proof.
FORGE_RELEASE_CANDIDATE_STATE=
FORGE_BUILD_TIME=
FORGE_LOCKFILE_DIGEST=
FORGE_CONTENT_MANIFEST_DIGEST=
FORGE_EVALUATOR_BASELINE_DIGEST=
FORGE_DATABASE_MIGRATION_IDENTITY=not_configured

# Local release verification can set this diagnostic value. A Vercel candidate
# uses provider-owned VERCEL_GIT_COMMIT_SHA instead.
FORGE_RELEASE_SHA=

# Vercel must inject VERCEL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA,
# VERCEL_DEPLOYMENT_ID, VERCEL_URL, and VERCEL_PROJECT_ID. Do not define them
# in this file or as caller-maintained project values.

# Do not add model-provider, cloud-account, database, or student-data secrets.
# The canonical Semester Desk release has no such integration.
